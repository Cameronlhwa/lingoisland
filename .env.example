
# DeepSeek API Key (for AI features like chat companion, vocabulary generation)
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# Nano Banana / Google Gemini API Key
# Only needed for one-time island library generation (npm run gen:island-library)
# Normal product flow uses pre-generated images from public/island-library/
# Preferred: NANO_BANANA_API_KEY. Alternatives: GEMINI_API_KEY, GOOGLE_API_KEY
NANO_BANANA_API_KEY=your-api-key-here

# Google Cloud Text-to-Speech API Key
GOOGLE_TTS_API_KEY=your-google-tts-api-key-here

# PostHog Analytics
NEXT_PUBLIC_POSTHOG_KEY=your-posthog-key-here
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
