
# Public site URL — use https://lingoisland.com in Production (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Server only — required by Stripe webhooks, reconciliation, and checkout auth.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Stripe
STRIPE_SECRET_KEY=sk_test_or_live_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Existing Topic Islands Pro prices.
STRIPE_PRICE_PRO_MONTHLY=price_replace_me_core_monthly
STRIPE_PRICE_PRO_YEARLY=price_replace_me_core_yearly

# DeepSeek API Key (AI chat, journeys, vocabulary and story generation)
DEEPSEEK_API_KEY=your-deepseek-api-key-here
# Optional, defaults to https://api.deepseek.com
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Google Cloud Text-to-Speech API Key
GOOGLE_TTS_API_KEY=your-google-tts-api-key-here

# SpeechSuper API credentials (server only — admin pronunciation scoring)
SPEECHSUPER_APP_KEY=your-speechsuper-app-key-here
SPEECHSUPER_SECRET_KEY=your-speechsuper-secret-key-here

# PostHog Analytics
NEXT_PUBLIC_POSTHOG_KEY=your-posthog-key-here
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Cron endpoint protection (required only if Vercel Cron is configured).
# Also protects /api/cron/sms-process (SMS webhook retries and cleanup).
# CRON_SECRET=generate-a-long-random-secret

# SMS texting practice (server only). Texting is hidden in the UI unless the
# Telnyx key, public key, from number, and verification secret are all set.
SMS_PROVIDER=telnyx
TELNYX_API_KEY=your-telnyx-api-key-here
# Ed25519 public key from Telnyx (Mission Control > Account Settings > Keys & Credentials)
TELNYX_PUBLIC_KEY=your-telnyx-public-key-here
TELNYX_FROM_NUMBER=+14165550123
# At least 32 random characters; used to hash verification codes and rate-limit keys.
# Rotating it invalidates pending codes. Generate with: openssl rand -hex 32
SMS_VERIFICATION_SECRET=generate-a-long-random-secret
# Optional: ISO country codes we can text (default US,CA)
# SMS_SUPPORTED_COUNTRIES=US,CA
# Optional: extra numbers we send from, comma-separated E.164 (inbound from these is ignored)
# SMS_OWN_NUMBERS=
# Optional: enables POST /api/sms/send for manual test texts to your own verified number
# SMS_MANUAL_SEND_ENABLED=false
# Local webhook testing only. Ignored when NODE_ENV=production.
SMS_WEBHOOK_ALLOW_UNSIGNED=false

# HSK subscription Stripe Price IDs (separate from the core $9.99/mo plan's
# STRIPE_PRICE_PRO_MONTHLY / STRIPE_PRICE_PRO_YEARLY).
# TODO(cameron): create these two prices in Stripe before launching HSK
# checkout — $14.99/mo monthly, $9.99/mo ($119.99/yr) annual — and fill in
# the real price IDs here / in .env.local.
STRIPE_PRICE_HSK_MONTHLY=price_replace_me_hsk_monthly
STRIPE_PRICE_HSK_ANNUAL=price_replace_me_hsk_annual
# Alias supported by checkout route (same as STRIPE_PRICE_HSK_ANNUAL):
# STRIPE_PRICE_HSK_YEARLY=price_replace_me_hsk_annual
